{
  "name": "rbac-organization-backend",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "worker": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/workers/queue.worker.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\"",
    "docker:redis": "docker-compose up -d",
    "docker:redis:stop": "docker-compose down",
    "docker:redis:logs": "docker-compose logs -f redis",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "lint": "eslint 'src/**/*.ts'"
  },
  "keywords": [],
  "author": "ChandaniM",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@types/bull": "^3.15.9",
    "bull": "^4.16.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.10.1",
    "multer": "^2.0.2",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "eslint": "^9.39.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
